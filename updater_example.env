# Copy this file to updater.env and fill in your values.

# How long to sleep between checks (seconds)
SLEEP_SECS=600
# How many times to retry fetching the current IP before giving up
MAX_RETRIES=2

# --- DuckDNS (optional) ---
# Comma-separated list of DuckDNS subdomains and your DuckDNS token.
DUCK_DOMAINS=example1,example2
DUCK_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Cloudflare (optional) ---
# API token with Zone > DNS > Edit permission for the record's zone.
CF_API_TOKEN=your-cloudflare-api-token
# The full record name to update; the zone is derived from it automatically.
CF_RECORD_NAME=dynamic.example.org
# Whether the record should be proxied through Cloudflare (orange cloud).
# Defaults to false (DNS-only) when unset. Set to true to enable the proxy.
#CF_PROXIED=false

# User-Agent sent with outbound HTTP requests
USER_AGENT=dyndns_upd_ip/1.0.0
# Path (inside the container) to the JSON list of IP-lookup HTTP services
HTTP_SERVICES=/config/http_services.json
